bind_addr = "127.0.0.1:6380"
max_connections = 4096
shard_count = 4
ttl_sweep_interval_ms = 1000
stats_interval_ms = 5000
transaction_mode = "shard_local"
# "fanout" exposes one public listener. Use "direct_shard" to also expose
# shard-owned direct ports starting at bind_addr + 1, or at
# SHARDCACHE_DIRECT_SHARD_BASE_PORT when that environment variable is set.
server_endpoint_mode = "fanout"

[tiers]
hot_capacity = 2048
warm_capacity = 8192
cold_capacity = 65536
promotion_batch = 256

[cuda]
enabled = false
device_ordinal = 0
hot_tier_bytes = 10737418240
pinned_host_bytes = 536870912
transfer_stream_count = 4
layer_streaming = true
prefer_direct_host_dma = true
pinned_staging_threshold_bytes = 2097152
allow_cpu_fallback = true

[persistence]
enabled = true
data_dir = "./var/shardcache"
segment_size_bytes = 67108864
fsync_interval_ms = 100
snapshot_every_seconds = 300
snapshot_min_writes = 1000
compress_snapshots = true
compress_wal = true
# Each shard seals its own WAL block without a shared producer lock. A single
# background merger writes and syncs those blocks into the canonical log.
wal_channel_capacity = 16384
wal_block_max_records = 64
wal_block_max_bytes = 262144

# Single-primary native FCRP v2 replication. Version 0.7.2 peers cannot mix
# with 0.7.1 peers. Non-loopback deployments require TLS 1.3 mTLS plus token
# authentication. Current/previous files permit bounded rolling rotation.
[replication]
enabled = false
role = "primary"
bind_addr = "127.0.0.1:7631"
# replica_of = "primary.internal:7631"
# auth_token_path = "/run/secrets/replication-token"
# previous_auth_token_path = "/run/secrets/replication-token-previous"
compression = "none"
send_policy = "batch"
batch_max_records = 512
batch_max_bytes = 1048576
batch_max_delay_us = 750
vector_state_flush_ms = 10
vector_state_pending_max_bytes = 16777216
backlog_bytes = 67108864
snapshot_chunk_bytes = 1048576
# Bound replica bootstrap memory. Raise deliberately for larger authoritative
# snapshots; a peer exceeding either limit is disconnected before replacement.
snapshot_receive_max_bytes = 1073741824
snapshot_receive_max_entries = 10000000
# Per-frame allocation ceiling. Control frames remain capped at 128 KiB.
receive_max_frame_bytes = 67108864
queue_capacity = 16384
max_replicas = 16
connect_timeout_ms = 500
# A partially received frame is abandoned by closing and reconnecting after
# this deadline; the stream is never resumed at an unknown frame boundary.
read_timeout_ms = 30000
write_timeout_ms = 500
reconnect_backoff_ms = 200
subscriber_channel_capacity = 1024

[replication.tls_server]
enabled = false
cert_path = "/run/secrets/replication-server.pem"
key_path = "/run/secrets/replication-server-key.pem"
# client_ca_path = "/run/secrets/replication-client-ca.pem"
# Optional CA-valid client leaf pins; retain old and new pins during rotation.
# client_cert_sha256 = ["0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"]
handshake_timeout_ms = 5000
reload_interval_ms = 30000
max_concurrent_handshakes = 256

[replication.tls_client]
enabled = false
ca_path = "/run/secrets/replication-ca.pem"
# client_cert_path = "/run/secrets/replication-client.pem"
# client_key_path = "/run/secrets/replication-client-key.pem"
# server_name = "primary.internal"

# Dedicated SCNP overflow replicas advertise stable topology and expose one
# direct listener per local shard. Do not enable this role and kv_overflow on
# the same server.
[kv_overflow_replica]
enabled = false
node_id = "overflow-a"
# Non-loopback replicas require TLS plus this token or mTLS unless
# allow_insecure_scnp is explicitly enabled. Use an environment variable for a
# static token or a mounted file for reloadable rolling rotation.
# auth_token_env = "SHARDCACHE_OVERFLOW_SCNP_TOKEN"
# auth_token_path = "/run/secrets/overflow-scnp-token"
# auth_token_reload_interval_ms = 30000
allow_insecure_scnp = false
# Ordinary LRU/LFU eviction without object_overflow is intentionally lossy.
allow_lossy_eviction = false
# Required with persistence after provisioning an encrypted filesystem/volume.
encrypted_persistence = true

[kv_overflow_replica.tls]
enabled = false
cert_path = "/run/secrets/overflow-server.pem"
key_path = "/run/secrets/overflow-server-key.pem"
# Setting a client CA enables mandatory mTLS client verification.
# client_ca_path = "/run/secrets/overflow-client-ca.pem"
# Pin one or more CA-valid client leaf certificates. Keep old and new entries
# during rotation.
# client_cert_sha256 = ["0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"]
handshake_timeout_ms = 5000
reload_interval_ms = 30000
max_concurrent_handshakes = 256

# Embedded-only partitioned overflow. Stable replica IDs preserve membership
# identity when addresses change. During exact rebalance, retain the old
# membership in previous_replicas until flush_remote completes.
[kv_overflow]
enabled = false
backend = "scnp"
cluster_id = "production-cache"
transport = "direct_shard"
slot_count = 16384
# During a restart that changes the primary `shard_count`, retain the old
# membership and set this to the old power-of-two shard count until handoff
# completes.
# previous_primary_shard_count = 8
# Redis backend only: addresses must be redis://, rediss://, valkey://, or
# valkeys:// URLs without credentials. Credentials are read from these env vars.
redis_key_prefix = "shardcache:overflow:"
# redis_username_env = "SHARDCACHE_OVERFLOW_REDIS_USERNAME"
# redis_password_env = "SHARDCACHE_OVERFLOW_REDIS_PASSWORD"
# SCNP backend only. Use the same token env value on the replica.
# scnp_auth_token_env = "SHARDCACHE_OVERFLOW_SCNP_TOKEN"
# scnp_auth_token_path = "/run/secrets/overflow-scnp-token"
# scnp_auth_token_reload_interval_ms = 30000
allow_insecure_scnp = false
max_memory_bytes = 1073741824
# Key-tracking memory is independent of resident value memory. Zero derives a
# bounded default from max_memory_bytes and max_key_bytes.
max_metadata_bytes = 268435456
max_key_bytes = 1048576
eviction_policy = "lfu"
queue_capacity_per_shard = 1024
pipeline_max_items = 64
pipeline_max_bytes = 262144
pipeline_flush_micros = 200
max_inflight_per_target = 1
adaptive_pipeline = true
pipeline_target_micros = 1000
circuit_breaker_failure_threshold = 8
circuit_breaker_cooldown_ms = 5000
# Optional worker-side compression; use "none" or "lz4".
compression = "none"
# Required before compression can emit the v2 envelope.
allow_envelope_v2_writes = false
compression_min_value_bytes = 4096
compression_min_savings_percent = 12
max_value_bytes = 67108864
compression_max_expansion_ratio = 256
connect_timeout_ms = 250
operation_timeout_ms = 500
max_retries = 2
retry_backoff_ms = 10
cleanup_interval_ms = 1000
fetch_on_miss = true
# Durable default: preserve metadata and make snapshots fail if a replica loses
# an acknowledged value. Set true only for intentionally lossy caches.
forget_remote_misses = false
# Aggregate rebalance bandwidth per primary shard. Zero is unlimited.
handoff_max_bytes_per_second = 0
handoff_max_concurrency = 16
handoff_batch_items = 1024
retained_buffer_bytes = 16384

[kv_overflow.scnp_tls]
enabled = false
ca_path = "/run/secrets/overflow-ca.pem"
# Configure both fields to use mTLS.
# client_cert_path = "/run/secrets/overflow-client.pem"
# client_key_path = "/run/secrets/overflow-client-key.pem"
# Required only for legacy address-only endpoints.
# server_name = "overflow.internal"

[[kv_overflow.replicas]]
id = "overflow-a"
addresses = ["10.0.0.11:6380"]
shard_count = 16
# Set to 0 to use the direct port base advertised by SCNP.TOPOLOGY.
direct_shard_base_port = 0
# Defaults to the stable replica ID when omitted.
tls_server_name = "overflow-a.internal"
