bind_addr = "127.0.0.1:6380"
max_connections = 4096
shard_count = 4
ttl_sweep_interval_ms = 1000
stats_interval_ms = 5000
transaction_mode = "shard_local"
# "fanout" exposes one public listener. Use "direct_shard" to also expose
# shard-owned direct ports starting at bind_addr + 1, or at
# SHARDCACHE_DIRECT_SHARD_BASE_PORT when that environment variable is set.
server_endpoint_mode = "fanout"

[tiers]
hot_capacity = 2048
warm_capacity = 8192
cold_capacity = 65536
promotion_batch = 256

[cuda]
enabled = false
device_ordinal = 0
hot_tier_bytes = 10737418240
pinned_host_bytes = 536870912
transfer_stream_count = 4
layer_streaming = true
prefer_direct_host_dma = true
pinned_staging_threshold_bytes = 2097152
allow_cpu_fallback = true

[persistence]
enabled = true
data_dir = "./var/shardcache"
segment_size_bytes = 67108864
fsync_interval_ms = 100
snapshot_every_seconds = 300
snapshot_min_writes = 1000
compress_snapshots = true
wal_channel_capacity = 16384

# Dedicated SCNP overflow replicas advertise stable topology and expose one
# direct listener per local shard. Do not enable this role and kv_overflow on
# the same server.
[kv_overflow_replica]
enabled = false
node_id = "overflow-a"

# Embedded-only partitioned overflow. Stable replica IDs preserve membership
# identity when addresses change. During exact rebalance, retain the old
# membership in previous_replicas until flush_remote completes.
[kv_overflow]
enabled = false
backend = "scnp"
cluster_id = "production-cache"
transport = "direct_shard"
slot_count = 16384
# During a restart that changes the primary `shard_count`, retain the old
# membership and set this to the old power-of-two shard count until handoff
# completes.
# previous_primary_shard_count = 8
# Redis backend only: addresses must be redis://, rediss://, valkey://, or
# valkeys:// URLs without credentials. Credentials are read from these env vars.
redis_key_prefix = "shardcache:overflow:"
# redis_username_env = "SHARDCACHE_OVERFLOW_REDIS_USERNAME"
# redis_password_env = "SHARDCACHE_OVERFLOW_REDIS_PASSWORD"
max_memory_bytes = 1073741824
eviction_policy = "lfu"
queue_capacity_per_shard = 1024
pipeline_max_items = 64
pipeline_max_bytes = 262144
pipeline_flush_micros = 200
max_inflight_per_target = 1
connect_timeout_ms = 250
operation_timeout_ms = 500
max_retries = 2
retry_backoff_ms = 10
cleanup_interval_ms = 1000
fetch_on_miss = true

[[kv_overflow.replicas]]
id = "overflow-a"
addresses = ["10.0.0.11:6380"]
shard_count = 16
# Set to 0 to use the direct port base advertised by SCNP.TOPOLOGY.
direct_shard_base_port = 0
