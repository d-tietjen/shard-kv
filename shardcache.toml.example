bind_addr = "127.0.0.1:6380"
max_connections = 4096
# Must be a non-zero power of two.
shard_count = 4
ttl_sweep_interval_ms = 1000
stats_interval_ms = 5000

[tiers]
hot_capacity = 2048
warm_capacity = 8192
cold_capacity = 65536
promotion_batch = 256

[cuda]
enabled = false
device_ordinal = 0
hot_tier_bytes = 10737418240
pinned_host_bytes = 536870912
transfer_stream_count = 4
layer_streaming = true
prefer_direct_host_dma = true
pinned_staging_threshold_bytes = 2097152
allow_cpu_fallback = true

[persistence]
enabled = true
data_dir = "./var/shardcache"
segment_size_bytes = 67108864
fsync_interval_ms = 100
snapshot_every_seconds = 300
snapshot_min_writes = 1000
compress_snapshots = true
compress_wal = true
wal_channel_capacity = 16384

[persistence.tcp_export]
enabled = false
mode = "connect"
addr = "127.0.0.1:7630"
# For listen mode, set auth_token and keep this endpoint on a trusted network.
# auth_token = "replace-me"
channel_capacity = 16384
max_subscribers = 64
connect_timeout_ms = 250
write_timeout_ms = 250
reconnect_backoff_ms = 100
backpressure_on_full = false

[object_overflow]
enabled = false
backend = "file" # "file" or "s3" with the object-overflow-s3 feature.
# Local/test adapter path for the object-overflow feature. S3-compatible
# RustFS deployments should set this to the service endpoint.
endpoint = "./var/object-overflow"
bucket = "shardcache"
prefix = "overflow"
node_id = "node-a"
region = "us-east-1"
force_path_style = true
allow_http = false
tls_verify = true
# server_side_encryption = "AES256"
# access_key_env = "RUSTFS_ACCESS_KEY"
# secret_key_env = "RUSTFS_SECRET_KEY"
min_value_bytes = 4096
# Values must be idle for this many access-clock ticks before overflow can
# offload them. This keeps recently written/read hot values resident.
offload_min_idle_ticks = 1024
# Optional historic heat cap. Use 4294967295 to disable the frequency gate.
offload_max_frequency = 4294967295
compression = "zstd"
zstd_level = 3
failure_policy = "retain_resident"
max_retries = 2
retry_backoff_ms = 10
operation_timeout_ms = 500
worker_threads = 2
queue_capacity = 1024
degraded_failure_threshold = 8
degraded_cooldown_ms = 5000
cleanup_on_start = false
cleanup_interval_seconds = 0
cleanup_grace_seconds = 86400
fetch_on_get = true
delete_on_overwrite = true

[replication]
enabled = false
role = "primary"
bind_addr = "127.0.0.1:7631"
# replica_of = "127.0.0.1:7631"
# auth_token = "replace-me"
compression = "none"
zstd_level = 3
send_policy = "batch"
batch_max_records = 64
batch_max_bytes = 262144
batch_max_delay_us = 250
backlog_bytes = 67108864
snapshot_chunk_bytes = 1048576
